  "data_flow": {
    "main_flow": [
      "Framework Foundation (vendor cordis/loader/schemastery - framework base)",
      "Input Sources (Web UI / CLI / ACP / SDK / Webhook)",
      "Gateway (api/gateway streaming + app-boot profile assembly)",
      "Core Processing (core/agent agent-loop: turn/step state machine)",
      "LLM (llm/llm: model request -> stream)",
      "Tool Execution (core/tools: tool/call -> tools/pre-execute -> tools/execute -> tools/post-execute -> tool/result)",
      "External Systems (LLM providers / files / network / storage)"
    ],
    "request_flow": "请求自输入层进入 api/gateway，经 app-boot 基于 vendor 框架装配的插件树进入 core agent-loop 的 turn/step 状态机；每 step 产生一次模型请求并调度工具",
    "async_flow": "SessionEvent 追加到日志并经 session/event 广播；agent/* 携带 live Agent；agent/assistant-stream 提供进程内流式帧；llm/stream 与 tools/* 为瀑布事件（需 next() 委托）",
    "message_flow": "输入经单一 inbox 进入驱动；模型历史由 deriveMessages() 从会话日志投影；turn 在输入被认领前打开、无欠债时关闭"
  },
