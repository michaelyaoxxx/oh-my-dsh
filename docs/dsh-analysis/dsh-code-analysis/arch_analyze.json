{
  "project_name": "deepseek-harness",
  "analysis_window": "2026-06-10 ~ 2026-09-15 (近12个月，仓库全部历史)",
  "architecture_layers": [
    {
      "layer_id": 0,
      "layer_name": "Framework Foundation",
      "description": "vendor/ 目录：源码式 vendored 的 Cordis 框架层（9 个 @deepseek-ai 包，可审计/可打补丁/锁定版本）",
      "responsibility": "提供插件元框架、事件总线、配置 schema、加载器/HMR/Include 等基础能力，被全部业务层依赖"
    },
    {
      "layer_id": 1,
      "layer_name": "Input Sources",
      "description": "用户请求和事件输入：Web/桌面 UI、CLI、ACP/SDK、Webhook",
      "responsibility": "接收任务并把请求翻译为会话输入"
    },
    {
      "layer_id": 2,
      "layer_name": "Gateway",
      "description": "API 网关、远程流式协议、profile/bundle 应用装配",
      "responsibility": "路由流量、建立会话、装配插件树"
    },
    {
      "layer_id": 3,
      "layer_name": "Core Processing",
      "description": "Agent 运行时、会话日志、系统提示、模型适配、子代理",
      "responsibility": "驱动 agent loop、维护会话状态、编排模型调用"
    },
    {
      "layer_id": 4,
      "layer_name": "Tool Execution",
      "description": "工具注册与执行管道、沙箱与权限",
      "responsibility": "按需执行工具并安全地访问宿主能力"
    },
    {
      "layer_id": 5,
      "layer_name": "External Systems",
      "description": "LLM 供应商、文件/SSH、网络服务、存储凭证",
      "responsibility": "对接外部能力并返回结果"
    }
  ],
